    family-names: Roskam
repository-code: "https://github.com/Reec1e33/aether-census"
url: "https://reec1e33.github.io/aether-census/deck.html"
license: MIT
date-released: 2026-10-22
keywords:
  - tool calling
  - function calling
  - JSON Schema
  - LLM
  - structured outputs

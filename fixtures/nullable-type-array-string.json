{
  "id": "nullable-type-array-string",
  "description": "A nullable string written as a type array, with pattern and maxLength.",
  "source": {
    "kind": "issue",
    "url": "https://github.com/BerriAI/litellm/issues/43325"
  },
  "keywords": ["type-array", "pattern", "maxLength"],
  "tool": {
    "name": "set_slug",
    "description": "Set a URL slug, or clear it.",
    "parameters": {
      "type": "object",
      "required": ["slug"],
      "properties": {
        "slug": {
          "type": ["string", "null"],
          "pattern": "^[a-z]+$",
          "maxLength": 6
        }
      }
    }
  },
  "valid": [
    {
      "slug": "news"
    },
    {
      "slug": null
    }
  ],
  "cases": [
    {
      "constraint": "/properties/slug/pattern",
      "invalid": {
        "slug": "ab1"
      }
    },
    {
      "constraint": "/properties/slug/maxLength",
      "invalid": {
        "slug": "abcdefgh"
      }
    }
  ]
}

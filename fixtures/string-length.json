{
  "id": "string-length",
  "description": "A string with a minimum and maximum length.",
  "source": {
    "kind": "synthetic"
  },
  "keywords": ["minLength", "maxLength"],
  "tool": {
    "name": "set_code",
    "description": "Set a short code.",
    "parameters": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 3,
          "maxLength": 5
        }
      },
      "required": ["code"]
    }
  },
  "valid": [
    {
      "code": "abcd"
    }
  ],
  "cases": [
    {
      "constraint": "/properties/code/minLength",
      "invalid": {
        "code": "ab"
      }
    },
    {
      "constraint": "/properties/code/maxLength",
      "invalid": {
        "code": "abcdef"
      }
    }
  ]
}

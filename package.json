{
  "name": "aether-census",
  "version": "0.0.0",
  "private": true,
  "description": "Measures which tool schemas each LLM provider and gateway accepts, rejects, or silently changes.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "census": "./dist/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "census": "tsx src/cli.ts"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@10.9.0"
}

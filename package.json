{
  "name": "aether-census",
  "version": "0.0.0",
  "private": true,
  "description": "Measures which tool schemas each LLM provider and gateway accepts, rejects, or silently changes.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "census": "./dist/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "census": "tsx src/cli.ts"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@ai-sdk/amazon-bedrock": "5.0.121",
    "@ai-sdk/anthropic": "4.0.85",
    "@ai-sdk/google": "4.0.102",
    "@ai-sdk/groq": "4.0.67",
    "@ai-sdk/mistral": "4.0.69",
    "@ai-sdk/openai": "4.0.99",
    "@ai-sdk/xai": "5.0.27",
    "@biomejs/biome": "^2.6.2",
    "@types/node": "^26.6.5",
    "ai": "7.0.148",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@10.9.0"
}
